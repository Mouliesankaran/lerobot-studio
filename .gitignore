# ==============================================================================
# Git Ignore Configuration for SO-101 Robotics & Vision Suite
# ==============================================================================

# Python build and cache artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.env.*
!.env.example
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ROS 2 Humble workspace build, install, and log folders
build/
install/
log/

# Node / Frontend package managers (if added)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editor caches (especially large C++ / IntelliSense databases)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.vscode/browse.vc.db*
*.db
*.db-shm
*.db-wal
.idea/
*.swp
*.swo
*~
.directory

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Large local recording files and rosbags (preserve folder structure with .gitkeep)
data/raw/*.csv
data/raw/*.txt
data/rosbag/*
!data/raw/.gitkeep
!data/rosbag/.gitkeep
!data/processed/.gitkeep

# Sensitive keys or credentials
*.pem
*.key
*.cert
*.crt
id_rsa
id_rsa.pub
